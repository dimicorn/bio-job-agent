# Relative paths resolve from the repository root. Discovery needs no secrets; optional LLM API keys are saved here by setup.
BIO_DATABASE_PATH=data/jobs.sqlite3
BIO_CANDIDATE_PATH=config/candidate.example.yaml
BIO_SOURCES_PATH=config/sources.yaml
BIO_HTTP_TIMEOUT=20
BIO_USER_AGENT=BioJobAgent/0.1 (local single-user job discovery)

BIO_CONFIG_PATH=config.yaml
BIO_LLM_STATE_DIR=data
# The setup wizard saves only the credentials you choose, with file mode 600.
# DEEPSEEK_API_KEY=...
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
